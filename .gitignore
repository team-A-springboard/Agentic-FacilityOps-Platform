facilityops.db
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- Secrets / local config (app reads FACILITYOPS_SECRET_KEY, _USERNAME, _PASSWORD from env) ---
.env
.env.*
!.env.example

# --- Flask ---
instance/
.webassets-cache

# --- Logs ---
*.log

# --- Testing / coverage ---
.coverage
htmlcov/
.tox/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
*.lnk