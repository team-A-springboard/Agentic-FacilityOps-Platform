# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/

